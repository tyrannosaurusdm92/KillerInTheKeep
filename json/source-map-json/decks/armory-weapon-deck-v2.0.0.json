  "source_basis": "Mundane weapon statistics use SRD 5.2.1. Magic inserts use SRD 5.2.1 magic items and retain their named extra energy/damage types.",
  "official_rule_note": "Official D&D permits anyone to wield a weapon but withholds the Proficiency Bonus when the wielder lacks proficiency.",
  "killer_in_the_keep_override": "For this game, a character who is not compatible with a found weapon cannot equip or attack with it; they may carry or trade it.",
  "draw_sources": [
    "armory_weapon_rack_1",
    "armory_weapon_rack_2",
    "any future fixture tagged weapon_rack"
  ],
  "draw_rule": "Investigate a weapon rack and resolve its Search/encounter trigger, then draw and reveal exactly one top card from this deck. Determine compatibility only after the card is revealed.",
  "carry_penalty": {
    "applies_to": "Each carried Armory Weapon card the carrier cannot use.",
    "legacy_roll_movement": "Subtract 1 traversable grid square from the movement die result per incompatible carried weapon; minimum final result 0 squares.",
    "tactical_speed_equivalent": "Subtract 5 feet of movement per incompatible carried weapon for the turn; minimum 0 feet after all modifiers.",
    "equipped_or_compatible_cards": "No penalty from compatible weapons, equipped weapons, evidence Weapon cards, or non-weapon treasure."
  },
  "trade_rule": {
    "requirements": [
      "Both characters are living and conscious.",
      "Both occupy the same named room or adjacent legal grid cells.",
      "Recipient is compatible with the traded weapon.",
      "Trade is accepted by the recipient or their bot logic."
    ],
    "enhancement": "The recipient immediately gives their currently equipped weapon a permanent +1 bonus to attack rolls and damage rolls for the remainder of the match.",
    "stacking": "Bonuses can stack to a maximum of +3 on one equipped weapon.",
    "anti_exploit": "Each Armory Weapon card can grant this enhancement only once. After granting it, mark the card bound_to_upgrade and remove it from further trade loops until match end.",
    "unequipped_recipient": "If the recipient has no equipped weapon, they equip the received weapon and it becomes +1."
  },
